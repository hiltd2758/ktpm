{
  "info": {
    "name": "E-Health Admin Patient REST API CRUD",
    "description": "Postman Collection for testing patient management REST API endpoints (CRUD operations) - Updated for new RESTful Controller",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patient READ Operations",
      "item": [
        {
          "name": "GET All Patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients"
              ]
            },
            "description": "Retrieve all patients. Returns array of patients with success flag and message."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains success flag and data', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('Data contains array of patients', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Patient by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients",
                "{{patientId}}"
              ]
            },
            "description": "Retrieve a specific patient by ID. Replace {{patientId}} with the actual patient ID."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 404', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response contains success flag and message', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('Valid response has patient object with ID, email, firstName, lastName', function () {",
                  "    if (pm.response.code === 200) {",
                  "        let jsonData = pm.response.json();",
                  "        pm.expect(jsonData.data).to.have.property('id');",
                  "        pm.expect(jsonData.data).to.have.property('email');",
                  "        pm.expect(jsonData.data).to.have.property('firstName');",
                  "        pm.expect(jsonData.data).to.have.property('lastName');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Retrieve patient information"
    },
    {
      "name": "Patient CREATE Operations",
      "item": [
        {
          "name": "POST Create New Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newpatient@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"address\": \"123 Main Street, Health City, HC 12345\",\n  \"phone\": \"+1-555-1234\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"medicalHistory\": \"No significant medical history\",\n  \"avatar\": \"https://example.com/avatars/default.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients"
              ]
            },
            "description": "Create a new patient. Email and password are required fields. Returns 201 on success, 400 on validation error."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 (Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response indicates successful creation', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.message).to.include('created');",
                  "});",
                  "",
                  "pm.test('Response contains created patient object with ID', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "    pm.expect(jsonData.data.email).to.equal('newpatient@example.com');",
                  "});",
                  "",
                  "pm.test('Save patient ID for later use', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.environment.set('patientId', jsonData.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Create Patient - Missing Email (Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"SecurePassword123!\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients"
              ]
            },
            "description": "Test validation error when email is missing. Should return 400."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 (Bad Request)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response indicates validation error', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "    pm.expect(jsonData.message).to.include('Email').or.to.include('required');",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Create new patient records"
    },
    {
      "name": "Patient UPDATE Operations",
      "item": [
        {
          "name": "PUT Update Patient Information",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.updated@example.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith Updated\",\n  \"address\": \"456 Wellness Avenue, Health City, HC 67890\",\n  \"phone\": \"+1-555-9876\",\n  \"dateOfBirth\": \"1992-03-20\",\n  \"medicalHistory\": \"Treated for diabetes in 2020\",\n  \"avatar\": \"https://example.com/avatars/patient-updated.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients",
                "{{patientId}}"
              ]
            },
            "description": "Update patient information (excluding password). All fields are optional - only provided fields are updated."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates successful update', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.message).to.include('updated');",
                  "});",
                  "",
                  "pm.test('Updated patient data is returned', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('lastName', 'Smith Updated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Update Patient Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewSecurePassword456!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients/{{patientId}}/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients",
                "{{patientId}}",
                "password"
              ]
            },
            "description": "Update patient password. Only the password endpoint accepts password updates."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates successful password update', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.message).to.include('password').and.to.include('updated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT Update Patient - Not Found (Error)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "disabled": false
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients",
                "99999"
              ]
            },
            "description": "Test 404 error when patient ID does not exist."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 (Not Found)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Response indicates patient not found', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "    pm.expect(jsonData.message).to.include('not found');",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Update existing patient records"
    },
    {
      "name": "Patient DELETE Operations",
