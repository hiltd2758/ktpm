  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL for the API server. Update this to match your server (e.g., http://localhost:8080, https://api.example.com)"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Admin authentication token. Set this after successful login via the admin authentication endpoint."
    },
    {
      "key": "patientId",
      "value": "1",
      "type": "string",
      "description": "Patient ID for use in other requests. This is automatically set after creating a new patient."
    }
  ]
}
