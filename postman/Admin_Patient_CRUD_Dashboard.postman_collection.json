                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/api/patients/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api",
                "patients",
                "{{patientId}}"
              ]
            },
            "description": "Delete a patient record by ID. This operation is irreversible. Returns 200 on success, 404 if not found."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates successful deletion', function () {",
                  "    let jsonData = pm.response.json();",
