  "item": [
    {
      "name": "GET Patient Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"patient_id\", jsonData.id);\r",
              "\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 1000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body contains correct patient info\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Kiểm tra phải có trường email và email phải khớp với tài khoản test\r",
              "    pm.expect(jsonData).to.have.property('email');\r",
              "    pm.expect(jsonData.email).to.eql(\"patient0123@gmail.com\");\r",
              "    \r",
              "    // Kiểm tra họ và tên không được để trống\r",
              "    pm.expect(jsonData.firstName).to.not.be.null;\r",
              "    pm.expect(jsonData.lastName).to.not.be.null;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "jwt-patient-token={{patient_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/patient/profile",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patient",
            "profile"
          ]
        }
      },
      "response": []
    },
    {
