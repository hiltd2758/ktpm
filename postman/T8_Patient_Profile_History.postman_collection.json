              "});\r",
              "\r",
              "pm.test(\"Update successful message\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.message).to.eql(\"Cập nhật thành công\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
